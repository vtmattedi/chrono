# Copy to .env (or let Stackport write it). Real values must not be committed.

# 64 hex characters (32 bytes): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ENC_KEY=replace_with_64_hex_characters

# Legacy startup check: must be non-empty.
JWT_SECRET=replace_with_long_random_string

# Credentials for /api/requestadmin
ADMIN_NAME=admin
ADMIN_PASSWD=replace_with_strong_password

# Optional: minutes before an unattended, empty session is removed (default 2880)
# AFK_CHECK_MINS=2880
