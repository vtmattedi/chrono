# Copy this file to .env for local development or provide these variables in
# your hosting/container environment.

# Server
PORT=4500
NODE_ENV=development

# Minutes before inactive users are considered AFK.
# Default in code: 2880 (48 hours)
AFK_CHECK_MINS=2880

# Frontend serving
# Leave unset/true to serve the built frontend from FRONTEND_FOLDER.
# Set to false to redirect all non-API routes to the configured CORS origin.
SERVER_ONLY=true
FRONTEND_FOLDER=./front/dist

# Token encryption
# JWT_ENC_KEY must be 32 random bytes encoded as 64 hex characters.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ENC_KEY=replace_with_64_hex_characters

# Legacy startup check. The current encrypted token flow uses JWT_ENC_KEY.
JWT_SECRET=replace_with_long_random_string

# Admin upgrade credentials
ADMIN_NAME=admin
ADMIN_PASSWD=replace_with_strong_password
